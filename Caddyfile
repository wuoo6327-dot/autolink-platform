{$SITE_ADDRESS} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Only immutable language files whose names contain their content hash.
	@fingerprintedLanguage {
		method GET HEAD
		path_regexp ^/i18n/chunks/(business|supplier)-(en|zh|ar|ru|kk|uz|ko|fr|sw)-[a-f0-9]{12}\.js$
		file {path}
	}
	header @fingerprintedLanguage {
		Cache-Control "public, max-age=31536000, immutable"
		defer
		match status 2xx 304
	}
	@auth path /auth/* /autolink/*
	handle @auth {
		reverse_proxy auth:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	@health path /healthz
	handle @health {
		reverse_proxy auth:8080
	}
	@api path /api /api/*
	@sitemap path /sitemap.xml /sitemaps/*
	handle @sitemap {
		rewrite * /autolink/public{uri}
		reverse_proxy auth:8080
	}
	handle @api {
		respond "Demo only: backend is not connected." 503
	}
	@legal path /privacy /terms /cookies /supplier-terms /account-deletion /disclaimer /membership-terms
	handle @legal {
		rewrite * /legal{path}.html
		file_server
	}
	@buyer path /buyer /buyer/*
	handle @buyer {
		route {
			try_files {path} /buyer/index.html
			header {
				Cache-Control "no-cache"
				X-Robots-Tag "noindex, nofollow"
			}
			file_server
		}
	}
	@support path /support /support/*
	handle @support {
		route {
			try_files {path} /support/index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
	@contact path /contact /contact-us
	redir @contact /support 302
	@aboutFile path /about.html
	redir @aboutFile /about 308
	@aboutPage path /about /about/
	handle @aboutPage {
		rewrite * /about.html
		header Cache-Control "no-cache"
		file_server
	}
	@oldBrands path /brands /brands/*
	redir @oldBrands /trade{uri} 302
	@oldVehicles path /vehicles /vehicles/*
	redir @oldVehicles /trade{uri} 302
	@oldModels path /models /models/*
	redir @oldModels /trade{uri} 302
	@oldSuppliers path /suppliers /suppliers/*
	redir @oldSuppliers /trade{uri} 302
	@oldRequests path /requests
	redir @oldRequests /buyer/requests 302
	@oldSupplierApplication path /supplier-apply
	redir @oldSupplierApplication /supplier/application 302
	@supplier path /supplier /supplier/*
	handle @supplier {
		route {
			try_files {path} /supplier/index.html
			header {
				Cache-Control "no-cache"
				X-Robots-Tag "noindex, nofollow"
			}
			file_server
		}
	}
	@admin path /admin /admin/*
	handle @admin {
		route {
			try_files {path} /admin/index.html
			header {
				Cache-Control "no-cache"
				X-Robots-Tag "noindex, nofollow"
			}
			file_server
		}
	}
	@merchantCenter path /merchant /merchant/dashboard
	redir @merchantCenter /supplier 302
	@account path /account /account/*
	handle @account {
		uri replace /account /buyer
		route {
			try_files {path} /buyer/index.html
			header {
				Cache-Control "no-cache"
				X-Robots-Tag "noindex, nofollow"
			}
			file_server
		}
	}
	@privatePages path /buyer /buyer/* /account /account/* /supplier /supplier/* /admin /admin/* /merchant /merchant/* /platform /platform/* /workspace /workspace/*
	header @privatePages X-Robots-Tag "noindex, nofollow"
	# Fixed file rewrites: query values are never interpolated into filesystem paths.
	@guideChinese {
		path /guide/supplier-verification /guide/vehicle-sourcing /guide/trade-process
		query lang=zh
	}
	handle @guideChinese {
		rewrite * {path}.zh.html
		header Cache-Control "no-cache"
		file_server
	}
	@guidePendingTranslation {
		path /guide/supplier-verification /guide/vehicle-sourcing /guide/trade-process
		query lang=ar lang=ru lang=kk lang=uz lang=ko lang=fr lang=sw
	}
	handle @guidePendingTranslation {
		rewrite * {path}.fallback.html
		header Cache-Control "no-cache"
		file_server
	}
	@guideDocument path /guide/supplier-verification /guide/vehicle-sourcing /guide/trade-process
	handle @guideDocument {
		rewrite * {path}.html
		header Cache-Control "no-cache"
		file_server
	}
	@middleEastPendingTranslation {
		path /guide/middle-east-importers
		query lang=zh lang=ar lang=ru lang=kk lang=uz lang=ko lang=fr lang=sw
	}
	handle @middleEastPendingTranslation {
		rewrite * /guide/middle-east-importers.fallback.html
		header Cache-Control "no-cache"
		file_server
	}
	@middleEastGuide path /guide/middle-east-importers
	handle @middleEastGuide {
		rewrite * /guide/middle-east-importers.html
		header Cache-Control "no-cache"
		file_server
	}
	@guideFiles path /guide /guide/*
	handle @guideFiles {
		header Cache-Control "no-cache"
		file_server
	}
	@publicTradeHTML {
		method GET HEAD
		path_regexp ^/trade(?:/[^.]+)?/?$
	}
	handle @publicTradeHTML {
		rewrite * /autolink/public/seo{uri}
		reverse_proxy auth:8080
	}
	@trade path /trade /trade/*
	handle @trade {
		route {
			try_files {path} /trade/index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
	@media path /images/* /fonts/*
	header @media Cache-Control "public, max-age=86400, stale-while-revalidate=86400"
	@script path /assets/* /videos/*
	header @script Cache-Control "public, max-age=0, must-revalidate"
	@static path /assets/* /images/* /fonts/* /videos/*
	handle @static {
		file_server
	}
	# Fixed homepage rewrites provide matching initial HTML for language URLs.
	@homeZh {
		path /
		query lang=zh
	}
	handle @homeZh {
		rewrite * /index.zh.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeAr {
		path /
		query lang=ar
	}
	handle @homeAr {
		rewrite * /index.ar.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeRu {
		path /
		query lang=ru
	}
	handle @homeRu {
		rewrite * /index.ru.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeKk {
		path /
		query lang=kk
	}
	handle @homeKk {
		rewrite * /index.kk.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeUz {
		path /
		query lang=uz
	}
	handle @homeUz {
		rewrite * /index.uz.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeKo {
		path /
		query lang=ko
	}
	handle @homeKo {
		rewrite * /index.ko.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeFr {
		path /
		query lang=fr
	}
	handle @homeFr {
		rewrite * /index.fr.html
		header Cache-Control "no-cache"
		file_server
	}
	@homeSw {
		path /
		query lang=sw
	}
	handle @homeSw {
		rewrite * /index.sw.html
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		route {
			try_files {path} /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
